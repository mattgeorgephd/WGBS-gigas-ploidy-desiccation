# --- R session / IDE artifacts ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# --- Download cache for inputs hosted on gannet (see 03_input_files/README.md) ---
03_input_files/gannet_cache/

# --- Large regenerable intermediates written by pipeline steps ---
04_output/*/cache/
06_diagnostics/*/cache/

# --- Per-CpG tables of the optional analyses at 5x (above the 50 MB limit; regenerated by step 05) ---
04_output/not_adopted/*cov5*/05_differential_methylation/tables/*.csv.gz
06_diagnostics/*/test_subset/

# --- renv library (the lockfile is tracked, the installed packages are not) ---
renv/library/
renv/local/
renv/staging/

# --- R Markdown render artifacts ---
*_cache/
*.knit.md
*.utf8.md

# --- OS / editor / Office cruft ---
.DS_Store
Thumbs.db
*~
~$*
.ipynb_checkpoints/
