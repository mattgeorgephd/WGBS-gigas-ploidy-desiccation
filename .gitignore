# --- R session / IDE artifacts ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# --- Download cache for inputs hosted on gannet (see 03_input_files/README.md) ---
03_input_files/gannet_cache/

# --- Large regenerable intermediates written by pipeline steps ---
04_output/*/cache/
06_diagnostics/*/cache/

# --- Per-CpG tables of the optional analyses (step 05; 13 to 22 MB each at 10x, up to 98 MB at 5x) ---
# An optional analysis commits its results, not its tables of every tested CpG:
# united_cpg_<id>.csv.gz and diffmeth_<contrast>_<id>.csv.gz are regenerated by
# rerunning step 05 for the analysis (half a minute with the fit in the cache).
# Step 05 writes the rows that step 13 reads at the DML (united_at_dml_<id>.csv,
# tracked). gene_table_<id>.csv.gz and ct_excluded_cpgs_<id>.csv.gz stay tracked.
# Exception: the analysis 'corrected', whose per-CpG tables predate the settings
# layout and are read by seven diagnostics of 06_diagnostics/ (column
# reads_corrected_files of 06_diagnostics/diagnostics.csv); they stay tracked.
# The patterns do not reach 04_output/not_adopted/ct_variants/ (no step folder).
04_output/not_adopted/*/05_differential_methylation/tables/united_cpg_*.csv.gz
04_output/not_adopted/*/05_differential_methylation/tables/diffmeth_*.csv.gz
!04_output/not_adopted/corrected/05_differential_methylation/tables/united_cpg_*.csv.gz
!04_output/not_adopted/corrected/05_differential_methylation/tables/diffmeth_*.csv.gz
06_diagnostics/*/test_subset/

# --- renv library (the lockfile is tracked, the installed packages are not) ---
renv/library/
renv/local/
renv/staging/

# --- R Markdown render artifacts ---
*_cache/
*.knit.md
*.utf8.md

# --- OS / editor / Office cruft ---
.DS_Store
Thumbs.db
*~
~$*
.ipynb_checkpoints/
