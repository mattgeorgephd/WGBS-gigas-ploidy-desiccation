====  QValuesfun  ====
function (rawp, pi0) 
{
    order_rawp = sort(rawp)
    qvalues = pi0 * length(order_rawp) * order_rawp/c(1:length(order_rawp))
    temp = cummin(qvalues[seq(length(qvalues), 1, -1)])
    qvalues = temp[seq(length(temp), 1, -1)]
    qvalues = qvalues[order(order(rawp))]
}
