==== calculateDiffMeth methylBase method ====
new("MethodDefinition", .Data = function (.Object, covariates = NULL, 
    overdispersion = c("none", "MN", "shrinkMN"), adjust = c("SLIM", 
        "holm", "hochberg", "hommel", "bonferroni", "BH", "BY", 
        "fdr", "none", "qvalue"), effect = c("wmean", "mean", 
        "predicted"), parShrinkMN = list(), test = c("F", "Chisq", 
        "fast.fisher", "midPval"), mc.cores = 1, slim = TRUE, 
    weighted.mean = TRUE, chunk.size = 1e+06, save.db = FALSE, 
    ...) 
{
    .checksCalculateDiffMeth(treatment = .Object@treatment, covariates = covariates, 
        Tcols = .Object@numTs.index)
    subst = S3Part(.Object, strictS3 = TRUE)
    x = .calculateDiffMeth(subst = subst, treatment = .Object@treatment, 
        covariates = covariates, overdispersion = overdispersion, 
        adjust = adjust, effect = effect, parShrinkMN = parShrinkMN, 
        test = test, slim = slim, weighted.mean = weighted.mean, 
        mc.cores = mc.cores)
    if (!save.db) {
        obj = new("methylDiff", x, sample.ids = .Object@sample.ids, 
            assembly = .Object@assembly, context = .Object@context, 
            destranded = .Object@destranded, treatment = .Object@treatment, 
            resolution = .Object@resolution)
        return(obj)
    }
    else {
        args <- list(...)
        if (!("dbdir" %in% names(args))) {
            dbdir <- .check.dbdir(getwd())
        }
        else {
            dbdir <- .check.dbdir(args$dbdir)
        }
        if (!("suffix" %in% names(args))) {
            suffix <- NULL
        }
        else {
            suffix <- paste0("_", args$suffix)
        }
        obj <- makeMethylDiffDB(df = x, dbpath = dbdir, dbtype = "tabix", 
            sample.ids = .Object@sample.ids, assembly = .Object@assembly, 
            context = .Object@context, destranded = .Object@destranded, 
            treatment = .Object@treatment, resolution = .Object@resolution, 
            suffix = suffix)
        message(paste0("flatfile located at: ", obj@dbpath))
        return(obj)
    }
}, target = new("signature", .Data = "methylBase", names = ".Object", 
    package = "methylKit"), defined = new("signature", .Data = "methylBase", 
    names = ".Object", package = "methylKit"), generic = "calculateDiffMeth")
