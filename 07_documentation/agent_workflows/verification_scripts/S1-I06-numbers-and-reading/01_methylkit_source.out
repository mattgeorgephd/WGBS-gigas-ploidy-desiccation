====  estimateShrinkageMN  ====
function (cntlist, treatment, covariates, sample.size = 1e+05, 
    mc.cores = 1) 
{
    message("Estimating shrinkage for scaling factor phi...")
    vars <- as.data.frame(cbind(treatment, covariates))
    formula <- as.formula(paste("~ ", paste(colnames(vars), collapse = "+")))
    modelMat <- model.matrix(formula, as.data.frame(vars))
    sample.size <- ifelse(length(cntlist) <= 1e+05, length(cntlist), 
        sample.size)
    estimation = simplify2array(mclapply(cntlist[1:sample.size], 
        estimatePhi, modelMat = modelMat, treatment = treatment, 
        mc.cores = mc.cores))
    phis <- estimation[1, ]
    df <- estimation[2, ]
    shr = squeezeVar(phis, df)
    list(df.prior = shr$df.prior, var.prior = shr$var.prior)
}
