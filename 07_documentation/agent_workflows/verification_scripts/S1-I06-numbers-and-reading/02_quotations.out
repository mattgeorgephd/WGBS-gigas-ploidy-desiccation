================ p.adjusted ================
function (pvals, method = c("SLIM", "holm", "hochberg", "hommel", 
    "bonferroni", "BH", "BY", "fdr", "none", "qvalue"), n = length(pvals), 
    fdr.level = NULL, pfdr = FALSE, STA = 0.1, Divi = 10, Pz = 0.05, 
    B = 100, Bplot = FALSE) 
{
    method <- match.arg(method)
    qvals = switch(method, SLIM = {
        QValuesfun(pvals, SLIMfunc(pvals, STA = STA, Divi = Divi, 
            Pz = Pz, B = B, Bplot = Bplot)$pi0_Est)
    }, holm = {
        p.adjust(pvals, method = method, n)
    }, hochberg = {
        p.adjust(pvals, method = method, n)
    }, hommel = {
        p.adjust(pvals, method = method, n)
    }, bonferroni = {
        p.adjust(pvals, method = method, n)
    }, BH = {
        p.adjust(pvals, method = method, n)
    }, BY = {
        p.adjust(pvals, method = method, n)
    }, fdr = {
        p.adjust(pvals, method = method, n)
    }, none = {
        p.adjust(pvals, method = method, n)
    }, qvalue = {
        qvalue(pvals, fdr.level, pfdr)$qvalues
    })
    return(qvals)
}
